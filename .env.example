# Discord bot
DISCORD_TOKEN=your_discord_bot_token
OWNER_ID=123456789012345678

# Pterodactyl panel
PTERO_PANEL_URL=https://panel.example.com
PTERO_API_KEY=ptla_your_application_api_key
PTERO_NODE_ID=1

# Java 25 image used for Minecraft 26.1+
JAVA25_IMAGE=ghcr.io/pterodactyl/yolks:java_25

# Optional bot settings
BOT_PREFIX=-
BOT_NAME=APMANAGER
BOT_STATUS=Managing Servers
